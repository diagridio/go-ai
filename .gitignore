# Binaries and build output
*.exe
*.dll
*.so
*.dylib
bin/
dist/

# `go build` in examples/<name>/ drops an extensionless binary named after the
# directory, which none of the patterns above match. Add a line when you add an example.
/examples/eino/eino
/examples/identity/identity
/examples/langchaingo/langchaingo
/examples/mcp/mcp

# Test / coverage output
*.test
*.out
coverage.*

# Go workspace files (local-only; the repo builds standalone)
go.work
go.work.sum

# Env / secrets
.env
.env.*
*.local

# macOS
.DS_Store

# Editors / IDEs
.idea/
.vscode/
*.swp
